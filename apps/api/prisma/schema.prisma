generator client {
  provider = "prisma-client"
  output   = "../src/common/infrastructure/database/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  applied
  screening
  interview
  technical_test
  offer
  accepted
  rejected
  withdrawn
  no_response
}

enum WorkModel {
  remote
  hybrid
  onsite
}

enum EventType {
  created
  status_change
  note
}

model Resume {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  file_name    String
  file_path    String
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  applications Application[]

  @@map("resumes")
}

model Application {
  id         Int                @id @default(autoincrement())
  company    String
  role       String
  job_url    String?
  source     String?
  applied_at DateTime           @default(now()) @db.Date
  status     Status             @default(applied)
  resume_id  Int?
  salary     String?
  work_model WorkModel?
  location   String?
  contacts   String?
  notes      String?
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  // Currículo em uso não pode ser excluído (a API responde 409).
  resume     Resume?            @relation(fields: [resume_id], references: [id], onDelete: Restrict)
  events     ApplicationEvent[]

  @@index([status])
  @@index([applied_at])
  @@index([resume_id])
  @@map("applications")
}

model ApplicationEvent {
  id             Int         @id @default(autoincrement())
  application_id Int
  type           EventType
  from_status    Status?
  to_status      Status?
  note           String?
  occurred_at    DateTime    @default(now())
  created_at     DateTime    @default(now())
  // Excluir a candidatura exclui todo o histórico dela.
  application    Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id, occurred_at])
  @@map("application_events")
}
